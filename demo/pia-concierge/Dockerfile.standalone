# PIA Concierge — STANDALONE agent container.
#
# One container = one agent tenant. Persistent state (assessments, the local
# store) lives under /data — mount a volume there. See DEPLOYMENT.md for the
# per-cloud run commands (Cloud Run, ECS/App Runner, Azure Container Apps),
# TLS/auth requirements, and the environment reference.
#
#   docker build -f Dockerfile.standalone -t pia-concierge:latest .
#   docker run -d -p 127.0.0.1:8890:8890 -v pia-data:/data \
#     -e ONETRUST_HOSTNAME=https://customer.my.onetrust.com \
#     -e ONETRUST_TOKEN=***  pia-concierge:latest
FROM python:3.12-slim

# Never run an internet-facing agent as root.
RUN useradd --create-home --uid 10001 pia
WORKDIR /opt/pia-concierge

COPY requirements-standalone.txt ./
RUN pip install --no-cache-dir -r requirements-standalone.txt

# The standalone agent: app + vendored engine + the verified OneTrust wire
# client and its deterministic advisors + templates. No maverick.
COPY app.py backend.py capabilities.py pia_engine.py store.py mailsink.py \
     onetrust_client.py ot_mock.py notice_check.py contract_guard.py \
     value_ledger.py license_kit.py serve_standalone.py paper_desk.py ./
COPY templates/ templates/
COPY static/ static/

ENV PIA_STANDALONE=1 \
    PIA_HOST=0.0.0.0 \
    WORLD_PORT=8890 \
    PIA_DATA_DIR=/data \
    EMAIL_SMTP_PORT=1025

RUN mkdir -p /data && chown -R pia:pia /data /opt/pia-concierge
USER pia
VOLUME ["/data"]
EXPOSE 8890

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD python -c "import urllib.request,sys;sys.exit(0 if b'ok' in urllib.request.urlopen('http://127.0.0.1:8890/health',timeout=3).read() else 1)"

CMD ["python", "serve_standalone.py"]
