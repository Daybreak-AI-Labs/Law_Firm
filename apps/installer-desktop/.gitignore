# Node / Vite
node_modules/
dist/
*.tsbuildinfo

# Rust / Tauri
src-tauri/target/

# Bundle icons are committed build inputs. Regenerate them intentionally during
# development, review the binary diff, and commit exactly the five variants
# referenced by tauri.conf.json. Mobile/store variants remain ignored.
src-tauri/icons/*
!src-tauri/icons/icon.png
!src-tauri/icons/32x32.png
!src-tauri/icons/128x128.png
!src-tauri/icons/128x128@2x.png
!src-tauri/icons/icon.icns
!src-tauri/icons/icon.ico

# Tauri build metadata
src-tauri/gen/
